{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SkyDexOnline/skydex-taxonomy/schema/aircraft-types.schema.json",
  "title": "Skydex curated aircraft types",
  "description": "Informative schema. scripts/validate.mjs is the authoritative check (it also enforces the alias/pseudo-key rejection and cross-file rules).",
  "type": "object",
  "properties": {
    "_readme": { "type": "string" }
  },
  "patternProperties": {
    "^[A-Z0-9]{2,4}$": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rarity": { "enum": ["common", "uncommon", "rare", "epic", "legendary", "mythical"] },
        "model": { "type": "string", "minLength": 3, "maxLength": 80 },
        "manufacturer": { "type": "string", "minLength": 2, "maxLength": 60 },
        "seats": { "type": "integer", "minimum": 1, "maximum": 900 },
        "rangeKm": { "type": "integer", "minimum": 50, "maximum": 20000 },
        "cruiseKts": { "type": "integer", "minimum": 30, "maximum": 700 },
        "engines": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "type"],
          "properties": {
            "count": { "type": "integer", "minimum": 1, "maximum": 8 },
            "type": { "enum": ["jet", "turboprop", "turboshaft", "piston", "electric"] }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
